{
  "name": "@sylphx/flux-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:rust && npm run build:ts",
    "build:rust": "cargo build --release",
    "build:wasm": "wasm-pack build crates/fastpack-wasm --target web --out-dir ../../packages/fastpack/wasm",
    "build:ts": "npm run build:flux",
    "test": "npm run test:rust && npm run test:ts",
    "test:rust": "cargo test",
    "test:ts": "npm -w fastpack run test",
    "clean": "cargo clean && npm -w fastpack run clean",
    "bench": "cargo bench",
    "lint:fix": "biome check --write .",
    "check:rust-authority": "bash scripts/check-rust-authority.sh",
    "check:flux-differential": "bash scripts/run-flux-differential.sh",
    "check:flux-pack-integrity": "bash scripts/check-flux-pack-integrity.sh",
    "check:flux-consumer-smoke": "bash scripts/check-flux-consumer-smoke.sh",
    "build:flux-wasm": "npm -w @sylphx/flux-wasm run build",
    "build:flux": "npm run build:flux-wasm && npm -w @sylphx/flux run build",
    "check:pack-integrity": "bash scripts/check-flux-pack-integrity.sh",
    "test:pack-integrity": "bun test test/packIntegrity.matrix.test.ts"
  },
  "devDependencies": {
    "wasm-pack": "^0.12.0",
    "@biomejs/biome": "^2.3.12",
    "@sylphx/biome-config": "^0.4.1"
  }
}
