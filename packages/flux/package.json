{
  "name": "@sylphx/flux",
  "version": "0.1.0",
  "description": "FLUX v2 - Schema-aware JSON compression for API traffic",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:fix": "biome check --write .",
    "prepack": "npm run build"
  },
  "keywords": [
    "compression",
    "json",
    "api",
    "wasm",
    "schema",
    "delta",
    "streaming",
    "flux"
  ],
  "author": "SylphxAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SylphxAI/flux.git",
    "directory": "packages/flux"
  },
  "dependencies": {
    "@sylphx/flux-wasm": "0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^1.0.0",
    "@biomejs/biome": "^2.3.12",
    "@sylphx/biome-config": "^0.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
